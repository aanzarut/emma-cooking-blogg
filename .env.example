# Copy this file to ".env" and fill in the key.
# The .env file is never committed to git — it stays on this computer only.

# Needed for "Read the recipe card". Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. Which model reads the recipe cards.
#   claude-opus-5   (default) most accurate on messy handwriting
#   claude-sonnet-5 cheaper, still good on clean printed cards
RECIPE_MODEL=claude-opus-5

# Optional. Change if port 4321 is already in use on this computer.
PORT=4321
